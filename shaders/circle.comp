#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PushConstants {
    float radius;
} pc;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D img;
layout(set = 1, binding = 0, rgba8ui) readonly uniform uimage3D voxelImage;

bool is_collide(float x, float y) {
    int column = int(x / (1.0 / 4.0));
    int row = int(y / (1.0 / 4.0));

    ivec3 texel_coord = ivec3(column, row, 0);
    uvec4 texel = imageLoad(voxelImage, texel_coord);

    return bool(texel.r != 0);
}

const int COLLIDE_YES = 0;
const int COLLIDE_NO = 1;
const int COLLIDE_OUT_OF_VOXEL = 2;
const int COLLIDE_ERROR = 3;


/// @return : collision result :
/// - COLLIDE_YES : collide;
/// - COLLIDE_NO : not collide;
/// - COLLIDE_OUT_OF_VOXEL : out of 3d shape.
int get_voxel_content(vec3 collide_point, out int color) {
    float x = collide_point[0];
    float y = collide_point[1];
    float z = collide_point[2];
    if (x >= 0.0 && x <= 4.0 && y >= 0.0 && y <= 4.0 && z >= 0.0 && z <= 4.0) {
        int vx = int(x / 1.0);
        int vy = int(y / 1.0);
        int vz = int(z / 1.0);

        ivec3 texel_coord = ivec3(vx, vy, vz);
        uvec4 texel = imageLoad(voxelImage, texel_coord);

        if (texel.r != 0) {
            color = int(z);
            return COLLIDE_YES;
        } else {
            return COLLIDE_NO;
        }
    } else {
        return COLLIDE_OUT_OF_VOXEL;
    }
}

float ceil_or_plus_1(float value) {
    if (mod(value, 1.0) == 0.0) {
        return value + 1.0;
    } else {
        return ceil(value);
    }
}

float floor_or_minus_1(float value) {
    if (mod(value, 1.0) == 0.0) {
        return value - 1.0;
    } else {
        return floor(value);
    }
}

vec3 get_coord_from_x(vec3 camera_position, vec3 ray_direction, float x) {
    float dx = ray_direction[0];
    float dy = ray_direction[1];
    float dz = ray_direction[2];
    float cx = camera_position[0];
    float cy = camera_position[1];
    float cz = camera_position[2];
    float t = (x - cx) / dx;
    float y = cy + dy * t;
    float z = cz + dz * t;
    return vec3(x, y, z);
}

vec3 get_coord_from_y(vec3 camera_position, vec3 ray_direction, float y) {
    float dx = ray_direction[0];
    float dy = ray_direction[1];
    float dz = ray_direction[2];
    float cx = camera_position[0];
    float cy = camera_position[1];
    float cz = camera_position[2];
    float t = (y - cy) / dy;
    float x = cx + dx * t;
    float z = cz + dz * t;
    return vec3(x, y, z);
}

vec3 get_coord_from_z(vec3 camera_position, vec3 ray_direction, float z) {
    float dx = ray_direction[0];
    float dy = ray_direction[1];
    float dz = ray_direction[2];
    float cx = camera_position[0];
    float cy = camera_position[1];
    float cz = camera_position[2];
    float t = (z - cz) / dz;
    float x = cx + dx * t;
    float y = cy + dy * t;
    return vec3(x, y, z);
}

float sum(vec3 v) {
    return v.x + v.y + v.z;
}

void closest_point(in vec3 xyz,
                   in vec3 x_collide,
                   in vec3 y_collide,
                   in vec3 z_collide,
                   out vec3 xyz_collide,
                   out int who_collide) {
    float dist_x =  dot(xyz - x_collide, xyz - x_collide);
    float dist_y =  dot(xyz - y_collide, xyz - y_collide);
    float dist_z =  dot(xyz - z_collide, xyz - z_collide);
    if (dist_x < dist_y) {
        if (dist_x < dist_z) {
            who_collide = 0;
            xyz_collide = x_collide;
        } else {
            who_collide = 2;
            xyz_collide = z_collide;
        }
    } else {
        if (dist_y < dist_z) {
            who_collide = 1;
            xyz_collide = y_collide;
        } else {
            who_collide = 2;
            xyz_collide = z_collide;
        }
    }
}

float get_next_axe_value(float value, float direction) {
    if (direction >= 0.0) {
        return ceil_or_plus_1(value);
    } else {
        return floor_or_minus_1(value);
    }
}

vec3 get_next_plan(vec3 position, vec3 direction) {
    float next_x = get_next_axe_value(position[0], direction[0]);
    float next_y = get_next_axe_value(position[1], direction[1]);
    float next_z = get_next_axe_value(position[2], direction[2]);
    return vec3(next_x, next_y, next_z);
}

/// @return : collision result :
/// - COLLIDE_YES : collide;
/// - COLLIDE_NO : not collide;
/// - COLLIDE_OUT_OF_VOXEL : out of 3d shape.
int is_collide_3d(vec3 camera_position, vec3 ray_direction, out int color) {
    vec3 plan = get_next_plan(camera_position, ray_direction);
    vec3 x_collide = get_coord_from_x(camera_position, ray_direction, plan[0]);
    vec3 y_collide = get_coord_from_y(camera_position, ray_direction, plan[1]);
    vec3 z_collide = get_coord_from_z(camera_position, ray_direction, plan[2]);

    vec3 collide_point = camera_position;
    int count = 0;
    while (true) {
        int who_collide = 0; // mean x collide. 1 if y collide, otherwise 2.
        vec3 tmp_collide_point = collide_point;
        closest_point(tmp_collide_point, x_collide, y_collide, z_collide, collide_point, who_collide);

        int is_line_collide = get_voxel_content(collide_point, color);
        switch (is_line_collide) {
            case COLLIDE_YES:
                return COLLIDE_YES;
            case COLLIDE_NO:
                break;
            case COLLIDE_OUT_OF_VOXEL:
                count = count + 1;
                if (count >= 100) {
                    return COLLIDE_OUT_OF_VOXEL;
                }
                break;
            default:
                return COLLIDE_ERROR;
        }

        // Move collide point :
        switch (who_collide) {
            case 0:
                float next_x = ceil_or_plus_1(collide_point[0]);
                x_collide = get_coord_from_x(camera_position, ray_direction, next_x);
                break;
            case 1:
                float next_y = ceil_or_plus_1(collide_point[1]);
                y_collide = get_coord_from_y(camera_position, ray_direction, next_y);
                break;
            case 2:
                float next_z = ceil_or_plus_1(collide_point[2]);
                z_collide = get_coord_from_z(camera_position, ray_direction, next_z);
                break;
            default:
                return COLLIDE_ERROR;
        }
    }
}

/// @param xy : Valute between 0.0 and 1.0;
/// @return : collision result :
/// - 0 : collide;
/// - 1 : not collide;
/// - 2 : out of 3d shape.
int is_collide_camera_to_ray(vec3 camera_position, vec3 camera_direction, vec2 xy, out int color) {
    // Here we compute the camera_direction
    vec3 ray_direction = camera_direction + vec3((xy - 0.5) * 2.0, 0.0);
    return is_collide_3d(camera_position, ray_direction, color);
}

void main() {
    ivec2 size = imageSize(img);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    ivec3 texel_coord = ivec3(0, 0, 0);
    uvec4 texel = imageLoad(voxelImage, texel_coord);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return; // out of bounds
    }

    // Normalize coords to [0,1]
    vec2 uv = vec2(pixel) / vec2(size);
    vec2 center = vec2(0.5, 0.5);
    float dist = distance(uv, center);

    vec4 color;
    float blue;
    if (dist < pc.radius) {
        blue = float(texel[0]);
    } else {
        blue = 0.0;
    }

    int rcolor = 0;
    switch (is_collide_camera_to_ray(vec3(0.0, 0.0, -5.0), vec3(0.0, 0.0, 1.0), uv, rcolor)) {
        case COLLIDE_YES:
            color = vec4(float(rcolor) / 4.0, 0.0, 0.0, 1.0);
            break;
        case COLLIDE_NO:
            color = vec4(0.0, 1.0, 0.0, 1.0);
            break;
        case COLLIDE_OUT_OF_VOXEL:
            color = vec4(0.0, 0.0, 1.0, 1.0);
            break;
        case COLLIDE_ERROR:
            color = vec4(0.0, 1.0, 1.0, 1.0);
            break;
        default:
            color = vec4(1.0, 1.0, 1.0, 1.0);
            break;
    }

    imageStore(img, pixel, color);
}
